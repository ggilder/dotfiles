# Let Option compose Unicode characters (em dash, etc.) instead of acting as Alt/Meta.
# Option+Arrow word-jumping is unaffected since arrows have no Unicode compose meaning.
macos-option-as-alt = false

# Appearance
maximize = true
window-padding-x = 8
window-padding-y = 8
macos-titlebar-style = transparent
theme = Subliminal
font-family = "JetBrains Mono"
font-size = 11
font-feature = -calt

# Tmux window navigation
keybind = super+shift+left_bracket=text:\x01p
keybind = super+shift+right_bracket=text:\x01n
