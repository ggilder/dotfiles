# Appearance
maximize = true
window-padding-x = 8
window-padding-y = 8
macos-titlebar-style = native
theme = Subliminal
font-family = "JetBrains Mono"
font-size = 11
font-feature = -calt

# Tmux window navigation
keybind = super+shift+left_bracket=text:\x01p
keybind = super+shift+right_bracket=text:\x01n
